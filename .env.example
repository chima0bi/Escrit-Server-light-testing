# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Mongo
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/escrit

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Paystack (test keys during the hackathon)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_BASE_URL=https://api.paystack.co

# Escrow
AUTO_RELEASE_HOURS=72

# Internal admin surface (manual dispute resolution). Comma-separated
# list of seller emails allowed to hit /api/admin/*. Leave empty to
# deny everyone (fails closed) - set this to your own seller account's
# email before the demo so you can resolve a dispute live.
ADMIN_EMAILS=you@example.com
